# GEMINI_API_KEY: Required for the free-tier image model (gemini-2.5-flash-image).
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required for the paid High Quality tier (gpt-image-1).
# Use your org's API key from https://platform.openai.com/api-keys
# (this is separate from a ChatGPT Enterprise seat login).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Copy this file to .env.local and fill in your keys.
